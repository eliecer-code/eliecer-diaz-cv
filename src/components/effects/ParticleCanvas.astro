---
import type { PresetName } from '../../lib/particles/ParticleTypes';

interface Props {
  preset: PresetName;
  class?: string;
}

const { preset, class: className } = Astro.props;
---

<div
  id={'particles-' + preset + '-' + crypto.randomUUID()}
  class:list={['particle-canvas', className]}
  data-particle-preset={preset}
  aria-hidden="true"
></div>

<style>
  .particle-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
</style>

<script>
  import { initParticles } from '../../lib/particles/ParticleManager';
  initParticles();
</script>
