<section class="contact section particle-host" id="contacto"><ParticleCanvas preset="attraction"/><h2 data-particle-exclude>¿Construimos<br/>algo <span>juntos?</span></h2><div class="contact-right" data-particle-exclude><p>Una idea, un proyecto o una conversación.<br/>El siguiente paso empieza aquí.</p><a class="email" href="mailto:eliecer.diaz97@outlook.com">eliecer.diaz97@outlook.com <Arrow/></a><div class="socials"><a href="https://github.com/eliecer-code" target="_blank" rel="noopener noreferrer">GitHub <Arrow/></a><a href="https://www.linkedin.com/in/eliecerdiar/" target="_blank" rel="noopener noreferrer">LinkedIn <Arrow/></a></div></div></section></main>
<footer><span>Eliecer Enrique Díaz Arrieta</span><span>Diseñado con intención. Construido con código.</span><a class="brand" href="#inicio" aria-label="Volver al inicio">ED<span>.</span></a></footer>
<script>
// Page resources are separate from the persistent Astro/BFCache lifecycle hooks.
const lifecycle = new AbortController();
let mountedMain: HTMLElement | null = null;
let disposePage: (() => void) | undefined;

function mountPage() {
  const main = document.querySelector<HTMLElement>('main');
  if (!main || main === mountedMain) return;
  disposePage?.();
  mountedMain = main;
  const page = new AbortController();
  const { signal } = page;
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = document.querySelector<HTMLElement>('#nav-links');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#nav-links a'));
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const animations = new Set<Animation>();

  function closeMenu() {
    menu?.setAttribute('aria-expanded', 'false');
    links?.classList.remove('open');
  }
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    links?.classList.toggle('open', open);
  }, { signal });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      menu.focus();
    }
  }, { signal });
  navLinks.forEach(link => link.addEventListener('click', closeMenu, { signal }));

  const sections = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      navLinks.forEach(link => {
        const active = link.getAttribute('href') === '#' + entry.target.id;
        link.classList.toggle('active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }
  }, { rootMargin: '-15% 0px -55% 0px' });
  main.querySelectorAll('section[id]').forEach(section => sections.observe(section));

  main.querySelectorAll<HTMLAnchorElement>('a[href^="#detalle-"]').forEach(link => {
    link.addEventListener('click', () => {
      const id = link.getAttribute('href')?.slice(1);
      const details = id ? document.getElementById(id) : null;
      if (details instanceof HTMLDetailsElement) details.open = true;
    }, { signal });
  });

  const reveals = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      reveals.unobserve(entry.target);
      // Never transform the section: particle coordinates stay in a stable host.
      if (motion.matches) continue;
      const animation = entry.target.animate([{ opacity: .65 }, { opacity: 1 }], {
        duration: 650,
        easing: 'cubic-bezier(.16,1,.3,1)',
      });
      animations.add(animation);
      const release = () => animations.delete(animation);
      animation.addEventListener('finish', release, { once: true, signal });
      animation.addEventListener('cancel', release, { once: true, signal });
    }
  }, { threshold: .1 });
  main.querySelectorAll('.section').forEach(section => reveals.observe(section));
  function cancelReveals() {
    animations.forEach(animation => animation.cancel());
    animations.clear();
  }
  motion.addEventListener('change', () => {
    if (motion.matches) cancelReveals();
    // The observer stays live; subsequent entries are static while reduction is enabled.
  }, { signal });

  disposePage = () => {
    closeMenu();
    sections.disconnect();
    reveals.disconnect();
    cancelReveals();
    page.abort();
    mountedMain = null;
    disposePage = undefined;
  };
}

const unmountPage = () => disposePage?.();
document.addEventListener('astro:before-swap', unmountPage, { signal: lifecycle.signal });
document.addEventListener('astro:page-load', mountPage, { signal: lifecycle.signal });
window.addEventListener('pagehide', unmountPage, { signal: lifecycle.signal });
window.addEventListener('pageshow', mountPage, { signal: lifecycle.signal });
mountPage();
if (import.meta.hot) import.meta.hot.dispose(() => {
  unmountPage();
  lifecycle.abort();
});
</script></body></html>

